/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "api",
	"main": "src/index.ts",
	"compatibility_date": "2026-11-23",
	"compatibility_flags": ["nodejs_compat"],
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true,
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "eventrip-db",
			"database_id": "7a684326-e718-49ef-abd4-671def938220",
			"migrations_dir": "../../packages/db/migrations"
		}
	],
	"r2_buckets": [
		{
			"binding": "UPLOADS",
			"bucket_name": "eventrip-uploads",
			"preview_bucket_name": "eventrip-uploads-preview"
		}
	],
	"services": [
		{
			"binding": "WEB_PUSH",
			"service": "web-push"
		},
		{
			"binding": "MAIL",
			"service": "mail"
		}
	],
	"queues": {
		"producers": [
			{
				"binding": "PUSH_QUEUE",
				"queue": "push-notifications"
			}
		]
	},
	"triggers": {
		"crons": ["*/5 * * * *"]
	},
	"vars": {
		"WAVE_MERCHANT_ID": "M_ci_d5gtAH7j1J1L"
	},
	"secrets": {
		"required": ["BOOTSTRAP_SUPER_ADMIN_EMAIL"]
	}
}
