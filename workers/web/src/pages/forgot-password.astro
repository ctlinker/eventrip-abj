---
import Layout from '../layouts/Layout.astro';
import ForgotPasswordForm from '../components/ForgotPasswordForm';
---

<Layout title="Mot de passe oublié — EVENTRIP-ABJ" noindex={true}>
	<section class="mx-auto max-w-6xl px-4 py-12 sm:px-6">
		<div class="mb-8 text-center">
			<h1 class="text-2xl sm:text-3xl font-bold text-slate-900">Mot de passe oublié ?</h1>
			<p class="mt-2 text-sm text-slate-600">
				Saisissez votre adresse email pour recevoir un lien sécurisé de réinitialisation.
			</p>
		</div>
		<ForgotPasswordForm client:load />
	</section>
</Layout>
