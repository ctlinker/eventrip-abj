---
import Layout from '../layouts/Layout.astro';
import ResetPasswordForm from '../components/ResetPasswordForm';
---

<Layout title="Nouveau mot de passe — EVENTRIP-ABJ" noindex={true}>
	<section class="mx-auto max-w-6xl px-4 py-12 sm:px-6">
		<div class="mb-8 text-center">
			<h1 class="text-2xl sm:text-3xl font-bold text-slate-900">Choisir un nouveau mot de passe</h1>
			<p class="mt-2 text-sm text-slate-600">
				Définissez un mot de passe d’au moins 8 caractères pour sécuriser votre compte.
			</p>
		</div>
		<ResetPasswordForm client:load />
	</section>
</Layout>
