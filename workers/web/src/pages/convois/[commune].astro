---
import Layout from '../../layouts/Layout.astro';
import EventsCatalog from '../../components/EventsCatalog';
import type { CommuneItem } from '../../lib/api';
import { buildBreadcrumbJsonLd, truncateMetaDescription } from '../../lib/seo';
import { fetchCatalogSSR, getSiteOrigin, toAbsoluteUrl } from '../../lib/ssr';

const STATIC_COMMUNES: CommuneItem[] = [
	{ id: 'com-abobo', name: 'Abobo', slug: 'abobo' },
	{ id: 'com-adjame', name: 'Adjamé', slug: 'adjame' },
	{ id: 'com-anyama', name: 'Anyama', slug: 'anyama' },
	{ id: 'com-attecoube', name: 'Attécoubé', slug: 'attecoube' },
	{ id: 'com-bingerville', name: 'Bingerville', slug: 'bingerville' },
	{ id: 'com-cocody', name: 'Cocody', slug: 'cocody' },
	{ id: 'com-koumassi', name: 'Koumassi', slug: 'koumassi' },
	{ id: 'com-marcory', name: 'Marcory', slug: 'marcory' },
	{ id: 'com-plateau', name: 'Plateau', slug: 'plateau' },
	{ id: 'com-port-bouet', name: 'Port-Bouët', slug: 'port-bouet' },
	{ id: 'com-songon', name: 'Songon', slug: 'songon' },
	{ id: 'com-treichville', name: 'Treichville', slug: 'treichville' },
	{ id: 'com-yopougon', name: 'Yopougon', slug: 'yopougon' },
];

const { commune: communeSlug = '' } = Astro.params;
const siteOrigin = getSiteOrigin(Astro.url);
const catalog = await fetchCatalogSSR(Astro.request);

const allCommunes = catalog.communes.length > 0 ? catalog.communes : STATIC_COMMUNES;
const normalizedSlug = communeSlug.trim().toLowerCase();
const matchedCommune =
	allCommunes.find((c) => c.slug.toLowerCase() === normalizedSlug) || null;

if (!matchedCommune) {
	Astro.response.status = 404;
}

const departingEvents = matchedCommune
	? catalog.events.filter((ev) =>
			ev.convoys.some(
				(cv) =>
					(cv.commune || '').trim().toLowerCase() ===
					matchedCommune.name.toLowerCase(),
			),
		)
	: [];

const pageTitle = matchedCommune
	? `Convois & Navettes événements au départ de ${matchedCommune.name} | EVENTRIP-ABJ`
	: 'Commune introuvable — EVENTRIP-ABJ';

const pageDescription = matchedCommune
	? truncateMetaDescription(
			`Réservez votre billet d'événement avec convoi aller-retour au départ de ${matchedCommune.name} (Abidjan). Paiement Wave sécurisé et billet QR code vérifié sur EVENTRIP-ABJ.`,
		)
	: "Découvrez les départs de convois événementiels par commune d'Abidjan.";

const jsonLd = matchedCommune
	? [
			buildBreadcrumbJsonLd(
				[
					{ name: 'Accueil', path: '/' },
					{
						name: `Convois ${matchedCommune.name}`,
						path: `/convois/${matchedCommune.slug}`,
					},
				],
				siteOrigin,
			),
			...(departingEvents.length > 0
				? [
						{
							'@context': 'https://schema.org',
							'@type': 'ItemList',
							name: `Événements avec départ depuis ${matchedCommune.name}`,
							itemListElement: departingEvents.slice(0, 20).map((ev, idx) => ({
								'@type': 'ListItem',
								position: idx + 1,
								name: ev.title,
								url: toAbsoluteUrl(`/events/${ev.slug}`, siteOrigin),
							})),
						},
					]
				: []),
		]
	: undefined;
---

<Layout
	title={pageTitle}
	description={pageDescription}
	canonicalPath={
		matchedCommune ? `/convois/${matchedCommune.slug}` : `/convois/${communeSlug}`
	}
	noindex={!matchedCommune}
	jsonLd={jsonLd}
>
	{
		!matchedCommune ? (
			<section class="mx-auto max-w-4xl px-4 py-12 sm:px-6 text-center">
				<p class="text-xs font-extrabold uppercase tracking-wider text-brand-700">
					Erreur 404
				</p>
				<h1 class="mt-2 text-2xl sm:text-3xl font-black text-slate-950">
					Commune introuvable
				</h1>
				<p class="mt-2 text-sm text-slate-600">
					Sélectionnez l’une des communes desservies dans le Grand Abidjan :
				</p>
				<div class="mt-6 flex flex-wrap justify-center gap-2">
					{allCommunes.map((c) => (
						<a
							href={`/convois/${c.slug}`}
							class="rounded-full border border-slate-200 bg-white px-4 py-2 text-xs font-bold text-slate-700 hover:border-brand-600 hover:text-brand-700 transition-colors"
						>
							{c.name}
						</a>
					))}
				</div>
			</section>
		) : (
			<>
				<section class="relative overflow-hidden border-b border-slate-200/80 bg-slate-50/70">
					<div class="mx-auto max-w-6xl px-4 py-10 sm:px-6">
						<nav
							aria-label="Fil d'Ariane"
							class="mb-4 flex items-center gap-2 text-xs font-medium text-slate-500"
						>
							<a href="/" class="text-brand-700 hover:underline">
								Accueil
							</a>
							<span aria-hidden="true">/</span>
							<span class="font-semibold text-slate-900">
								Convois {matchedCommune.name}
							</span>
						</nav>

						<h1 class="text-2xl sm:text-4xl font-black tracking-tight text-slate-950">
							Convois &amp; Navettes événements au départ de{' '}
							<span class="text-brand-600">{matchedCommune.name}</span>
						</h1>
						<p class="mt-3 max-w-3xl text-sm sm:text-base text-slate-600 leading-relaxed">
							Réservez en une seule commande votre ticket d’événement et votre place de transport aller-retour depuis{' '}
							<strong class="text-slate-900">{matchedCommune.name}</strong>. Rassemblement encadré, règlement rapide par Wave et billet QR code vérifié à l’aller comme au retour.
						</p>

						<div class="mt-6 flex flex-wrap items-center gap-1.5">
							<span class="mr-1 text-xs font-bold text-slate-500">
								Autres départs :
							</span>
							{allCommunes
								.filter((c) => c.slug !== matchedCommune.slug)
								.slice(0, 8)
								.map((c) => (
									<a
										href={`/convois/${c.slug}`}
										class="rounded-full border border-slate-200 bg-white px-3 py-1 text-xs font-semibold text-slate-700 hover:border-brand-500 hover:text-brand-700 transition-colors"
									>
										{c.name}
									</a>
								))}
						</div>
					</div>
				</section>

				<EventsCatalog
					showHero={false}
					ssrLoaded={catalog.ok}
					initialEvents={catalog.events}
					initialEventCategories={catalog.eventCategories}
					initialCommunes={allCommunes}
					initialWishlistIds={catalog.wishlistIds}
					initialCommune={matchedCommune.name}
					sectionTitle={`Sorties accessibles depuis ${matchedCommune.name}`}
					sectionSubtitle={
						departingEvents.length > 0
							? `${departingEvents.length} événement(s) proposent actuellement un départ direct depuis ${matchedCommune.name}`
							: `Les événements avec départ depuis ${matchedCommune.name} apparaissent automatiquement en tête de liste`
					}
					client:load
				/>
			</>
		)
	}
</Layout>
