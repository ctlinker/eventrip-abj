---
import Layout from '../layouts/Layout.astro';
import ChangePasswordForm from '../components/ChangePasswordForm';
---

<Layout title="Changer mon mot de passe — EVENTRIP-ABJ">
	<section class="mx-auto max-w-6xl px-4 py-12 sm:px-6">
		<div class="mb-8 text-center">
			<h1 class="text-2xl sm:text-3xl font-bold text-slate-900">Sécurité du compte</h1>
			<p class="mt-2 text-sm text-slate-600">
				Modifiez votre mot de passe actuel directement depuis votre session active.
			</p>
		</div>
		<ChangePasswordForm client:load />
	</section>
</Layout>
