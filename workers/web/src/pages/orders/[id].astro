---
import Layout from '../../layouts/Layout.astro';
import OrderDetail from '../../components/OrderDetail';

const { id } = Astro.params;
---

<Layout title="Détail commande — EVENTRIP-ABJ" noindex={true}>
	<section class="mx-auto max-w-4xl px-4 py-10 sm:px-6">
		<a href="/orders" class="inline-block text-sm font-medium text-green-700 hover:underline mb-6">
			← Retour à mes commandes
		</a>
		<OrderDetail orderId={id || ''} client:load />
	</section>
</Layout>
