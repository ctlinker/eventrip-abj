---
import '../styles/global.css';
import { env } from 'cloudflare:workers';
import { tryCatch } from 'utils';
import Navbar from '../components/Navbar';
import type { ApiUser } from '../lib/api';

interface Props {
	title?: string;
}

const { title = 'EVENTRIP-ABJ — Billetterie & Convois' } = Astro.props;
const currentPath = Astro.url.pathname;

let initialUser: ApiUser | null = null;
let ssrResolved = false;

const api = (env as Partial<Env>)?.API;
if (api) {
	const cookie = Astro.request.headers.get('cookie');
	if (!cookie) {
		ssrResolved = true;
	} else {
		const res = await tryCatch(
			api.fetch(
				new Request('http://internal/api/auth/get-session', {
					headers: { cookie },
				}),
			),
		);
		if (res.ok && res.data.ok) {
			const json = await tryCatch(res.data.json() as Promise<{ user?: ApiUser } | null>);
			if (json.ok) {
				initialUser = json.data?.user ?? null;
				ssrResolved = true;
			}
		}
	}
}
---

<!doctype html>
<html lang="fr">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="theme-color" content="#0e1827" />
		<meta name="mobile-web-app-capable" content="yes" />
		<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
		<meta name="apple-mobile-web-app-title" content="EVENTRIP" />
		<link rel="manifest" href="/manifest.webmanifest" />
		<link rel="apple-touch-icon" href="/icon-192.png" />
		<link rel="icon" type="image/png" href="/logo.png" />
		<link rel="icon" href="/favicon.ico" />
		<link rel="stylesheet" href="/satoshi_fonts/WEB/css/satoshi.css" />
		<title>{title}</title>
	</head>
	<body class="min-h-screen bg-white text-navy-950 flex flex-col">
		<Navbar initialUser={initialUser} ssrResolved={ssrResolved} currentPath={currentPath} client:load />
		<main class="flex-1">
			<slot />
		</main>
		<div class="mt-20 h-3 w-full border-y border-brand-200/70 bg-hatched-gold" aria-hidden="true"></div>
		<footer class="bg-navy-950 py-8 text-slate-300">
			<div class="mx-auto max-w-6xl px-4 sm:px-6 flex flex-col sm:flex-row items-center justify-between gap-4 text-sm">
				<div class="flex items-center gap-3">
					<img
						src="/logo.png"
						alt="ABJ-TRIPEVENT"
						width="36"
						height="36"
						class="h-9 w-9 rounded-full object-contain shrink-0"
					/>
					<p class="font-bold text-white tracking-tight">
						EVENTRIP<span class="text-brand-300">.</span>{' '}
						<span class="font-normal text-slate-400">· Événements &amp; Convois en Côte d'Ivoire</span>
					</p>
				</div>
				<p class="text-slate-400">Paiements sécurisés Wave · Billets Aller-Retour vérifiés</p>
			</div>
		</footer>
	</body>
</html>
