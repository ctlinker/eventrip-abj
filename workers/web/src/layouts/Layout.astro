---
import '../styles/global.css';
import { env } from 'cloudflare:workers';
import { tryCatch } from 'utils';
import Navbar from '../components/Navbar';
import type { ApiUser } from '../lib/api';

interface Props {
	title?: string;
}

const { title = 'EVENTRIP-ABJ — Billetterie & Convois' } = Astro.props;

let initialUser: ApiUser | null = null;
let ssrResolved = false;

const api = (env as Partial<Env>)?.API;
if (api) {
	const cookie = Astro.request.headers.get('cookie');
	if (!cookie) {
		ssrResolved = true;
	} else {
		const res = await tryCatch(
			api.fetch(
				new Request('http://internal/api/auth/get-session', {
					headers: { cookie },
				}),
			),
		);
		if (res.ok && res.data.ok) {
			const json = await tryCatch(res.data.json() as Promise<{ user?: ApiUser } | null>);
			if (json.ok) {
				initialUser = json.data?.user ?? null;
				ssrResolved = true;
			}
		}
	}
}
---

<!doctype html>
<html lang="fr">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="stylesheet" href="/satoshi_fonts/WEB/css/satoshi.css" />
		<title>{title}</title>
	</head>
	<body class="min-h-screen bg-white text-slate-900 flex flex-col">
		<Navbar initialUser={initialUser} ssrResolved={ssrResolved} client:load />
		<main class="flex-1">
			<slot />
		</main>
		<footer class="border-t border-green-100 bg-green-50/40 py-8 mt-16">
			<div class="mx-auto max-w-6xl px-4 sm:px-6 flex flex-col sm:flex-row items-center justify-between gap-4 text-sm text-slate-500">
				<p class="font-medium text-slate-700">
					EVENTRIP<span class="text-green-600">-ABJ</span> · Billetterie &amp; Convois Côte d'Ivoire
				</p>
				<p>Paiements sécurisés par vérification Wave</p>
			</div>
		</footer>
	</body>
</html>
