/**
 * Worker dédié Web Push (Queue consumer) & Temps réel WebSocket (Durable Object UserRealtimeHub)
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "web-push",
	"main": "src/index.ts",
	"compatibility_date": "2026-11-23",
	"compatibility_flags": ["nodejs_compat"],
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true,
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "eventrip-db",
			"database_id": "7a684326-e718-49ef-abd4-671def938220",
			"migrations_dir": "../../packages/db/migrations"
		}
	],
	"durable_objects": {
		"bindings": [
			{
				"name": "USER_REALTIME_HUB",
				"class_name": "UserRealtimeHub"
			}
		]
	},
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": ["UserRealtimeHub"]
		}
	],
	"queues": {
		"consumers": [
			{
				"queue": "push-notifications",
				"max_batch_size": 25,
				"max_batch_timeout": 5,
				"max_retries": 5,
				"retry_delay": 60,
				"dead_letter_queue": "push-notifications-dlq"
			}
		]
	},
	"vars": {
		"VAPID_SUBJECT": "mailto:contact@eventrip.ci"
	}
}
